@model OnlineShop.Web.ViewModels.Favourites.FavouriteListViewModel
@{
    ViewData["Title"] = "Избранное";
}

<section class="section-divider">
    <div class="section-head">
        <h2 class="section-title">ИЗБРАННОЕ<span class="accent">.</span></h2>
        <div class="label-mono text-brutal-muted">
            ★ @Model.Items.Count
            @(Model.Items.Count == 1 ? "товар" : Model.Items.Count < 5 ? "товара" : "товаров")
        </div>
    </div>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <div class="empty-state-icon">∅</div>
            <p class="empty-state-text">В избранном пока пусто</p>
            <a asp-controller="Product" asp-action="Index" class="btn-brutal">Открыть каталог</a>
        </div>
    }
    else
    {
        <div class="products-grid">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                var num = (i + 1).ToString("D3");
                <div class="product-card product-card-fav">
                    <a class="product-card-main"
                       asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                        <div class="product-img-wrap">
                            @if (!string.IsNullOrEmpty(item.ProductImagePath))
                            {
                                <img src="@item.ProductImagePath" alt="@item.ProductName" />
                            }
                            else
                            {
                                <div class="product-img-placeholder">
                                    @(item.ProductName.Length > 0 ? item.ProductName.Substring(0, 1).ToUpper() : "?")
                                </div>
                            }
                            <span class="product-num">★ № @num</span>
                        </div>
                        <div class="product-body">
                            <h3 class="product-name">@item.ProductName</h3>
                            <p class="product-desc">
                                @if (!item.ProductIsAvailable)
                                {
                                    <span style="color: var(--orange); font-weight: 700;">★ Недоступен</span>
                                }
                                else
                                {
                                    <span>@item.AddedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                }
                            </p>
                        </div>
                    </a>

                    <div class="product-footer">
                        <div class="price">@item.ProductPrice.ToString("N0") ₽</div>

                        @if (item.ProductIsAvailable)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Favourite")" />
                                <button type="submit" class="add-cart-btn">★ В корзину</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="add-cart-btn" disabled>★ Недоступен</button>
                        }

                        <form asp-controller="Favourite" asp-action="Remove" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="remove-fav-btn">× Убрать</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</section>
