<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Decimal accept-both: и точка, и запятая.
    // Серверная сторона уже на en-US (см. Program.cs UseRequestLocalization),
    // здесь — фикс клиентской валидации jquery-validation которая иначе
    // отбрасывает один из вариантов в зависимости от browser locale.
    $(function () {
        $.validator.methods.number = function (value, element) {
            return this.optional(element) ||
                /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        };
        var originalRange = $.validator.methods.range;
        $.validator.methods.range = function (value, element, param) {
            var normalized = (value + '').replace(',', '.');
            return originalRange.call(this, normalized, element, param);
        };
    });
</script>
