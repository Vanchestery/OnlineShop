<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BREWCO</title>

    @* Google Fonts: Bebas Neue (заголовки), Space Mono (метки), DM Sans (тело) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />

    @* Bootstrap — оставлен для grid/flex/utility классов. Brutal.css подключается ПОСЛЕ
       и переопределяет визуальные компоненты. *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/brutal.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* Брутал-навигация: лого слева, ссылки, справа — избранное/корзина/аутх *@
        <nav class="site-nav">
            <a class="nav-logo" asp-controller="Home" asp-action="Index">BREWCO</a>

            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li><a asp-controller="Product" asp-action="Index">Каталог</a></li>
            </ul>

            <div class="nav-spacer"></div>

            <div class="nav-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-fav" asp-controller="Favourite" asp-action="Index" title="Избранное">♥</a>
                }
                @await Component.InvokeAsync("CartBadge")
                <partial name="_LoginPartial" />
            </div>
        </nav>

        @* Анимированный тикер под навигацией *@
        <div class="ticker-wrap">
            <div class="ticker">
                <span>★ Свежая обжарка каждый понедельник</span>
                <span>★ Доставка по всей России</span>
                <span>★ Specialty grade only</span>
                <span>★ Кофе · Чай · Аксессуары</span>
                <span>★ Direct trade</span>
                <span>★ Свежая обжарка каждый понедельник</span>
                <span>★ Доставка по всей России</span>
                <span>★ Specialty grade only</span>
                <span>★ Кофе · Чай · Аксессуары</span>
                <span>★ Direct trade</span>
            </div>
        </div>
    </header>

    @if (TempData["StatusMessage"] is string status)
    {
        <div class="brutal-alert">
            <span>★ @status</span>
            <button type="button" class="brutal-alert-close" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <main class="brutal-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <a class="footer-logo" asp-controller="Home" asp-action="Index">BREWCO</a>
        <div class="footer-text">© @DateTime.Now.Year · Specialty Coffee</div>
        <ul class="footer-links">
            <li><a asp-controller="Product" asp-action="Index">Каталог</a></li>
            <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
        </ul>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
