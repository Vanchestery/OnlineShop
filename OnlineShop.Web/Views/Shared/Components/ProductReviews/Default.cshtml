@model OnlineShop.Web.ViewModels.Reviews.ProductReviewsViewModel
@using OnlineShop.Web.Helpers
@{
    var fullStars = (int)Math.Round(Model.AverageRating);
    var emptyStars = 5 - fullStars;
    var starsHtml = new string('★', fullStars) + new string('☆', emptyStars);
}

<div class="reviews-section">
    <div class="avg-rating-bar">
        <span class="avg-rating-stars">@starsHtml</span>
        @if (Model.Count > 0)
        {
            <div>
                <div class="avg-rating-num">@Model.AverageRating.ToString("0.0")</div>
                <div class="avg-rating-meta">★ из 5 / @Model.Count @RussianPluralizer.Reviews(Model.Count)</div>
            </div>
        }
        else
        {
            <div class="avg-rating-meta">★ Пока нет отзывов</div>
        }
    </div>

    @if (Model.IsAuthenticated)
    {
        <div class="review-form-block brutal-form">
            <h3 class="review-form-title">Оставить отзыв</h3>
            <form asp-controller="Reviews" asp-action="Add" method="post">
                <input type="hidden" asp-for="NewReview.ProductId" />

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label asp-for="NewReview.Rating">Оценка</label>
                        <select asp-for="NewReview.Rating">
                            <option value="5">★★★★★ (5)</option>
                            <option value="4">★★★★ (4)</option>
                            <option value="3">★★★ (3)</option>
                            <option value="2">★★ (2)</option>
                            <option value="1">★ (1)</option>
                        </select>
                        <span asp-validation-for="NewReview.Rating"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="NewReview.Text">Текст отзыва</label>
                    <textarea asp-for="NewReview.Text" rows="4"
                              placeholder="Что понравилось, что нет..."></textarea>
                    <span asp-validation-for="NewReview.Text"></span>
                </div>

                <button type="submit" class="btn-brutal">Опубликовать</button>
            </form>
        </div>
    }
    else
    {
        <div class="login-prompt">
            ★ <a asp-controller="Account" asp-action="Login"
                 asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.ProductId })">
                Войдите
            </a>, чтобы оставить отзыв
        </div>
    }

    @if (Model.Items.Count > 0)
    {
        @foreach (var review in Model.Items)
        {
            var rStars = new string('★', review.Rating) + new string('☆', 5 - review.Rating);
            <div class="review">
                <div class="review-head">
                    <div class="review-author-block">
                        <span class="review-author">@review.UserName</span>
                        <span class="review-stars">@rStars</span>
                    </div>
                    <span class="review-date">@review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                </div>
                <p class="review-text">@review.Text</p>
            </div>
        }
    }
</div>
