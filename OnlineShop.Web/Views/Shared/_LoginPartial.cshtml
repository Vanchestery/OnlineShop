@using Microsoft.AspNetCore.Identity
@using OnlineShop.Db
@using OnlineShop.Db.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var name = currentUser?.FirstName ?? "Аккаунт";

    @* Имя юзера → ссылка в профиль *@
    <a class="nav-text-link" asp-controller="Account" asp-action="Profile" title="Профиль">
        @name
    </a>

    @if (User.IsInRole(RoleNames.Admin))
    {
        <a class="nav-admin" asp-area="Admin" asp-controller="Products" asp-action="Index"
           title="Админ-панель">[ADMIN]</a>
    }

    @* Logout как POST-форма (CSRF-safe), стилизована как кнопка-ссылка *@
    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 d-flex">
        <button type="submit" class="nav-text-link">Выйти</button>
    </form>
}
else
{
    <a class="nav-text-link" asp-controller="Account" asp-action="Login">Войти</a>
    <a class="nav-text-link" asp-controller="Account" asp-action="Register">Регистрация</a>
}
