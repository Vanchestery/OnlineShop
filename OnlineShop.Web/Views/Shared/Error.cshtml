@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="section-divider access-denied">
    <h1 class="access-denied-num">@Model.StatusCode</h1>
    <p class="access-denied-text">@Model.Title</p>
    <p class="access-denied-desc">★ @Model.Description</p>

    @if (Model.ShowRequestId)
    {
        <p class="access-denied-desc" style="margin-bottom: 24px;">
            ★ Request ID: <code style="background: var(--black); color: var(--lime); padding: 2px 6px;">@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-brutal btn-brutal-lg">На главную</a>
</section>
