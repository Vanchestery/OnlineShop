@model OnlineShop.Web.ViewModels.Catalog.ProductListViewModel
@{
    ViewData["Title"] = "Каталог";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Каталог</h1>
    <small class="text-muted">Найдено: @Model.TotalCount</small>
</div>

<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <input type="search" name="query" value="@Model.Query"
               class="form-control" placeholder="Поиск по названию или описанию..." />
        <button type="submit" class="btn btn-outline-dark">Найти</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light text-center py-5">
        @if (string.IsNullOrWhiteSpace(Model.Query))
        {
            <span>В каталоге пока ничего нет.</span>
        }
        else
        {
            <span>По запросу <strong>«@Model.Query»</strong> ничего не найдено.</span>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <partial name="_ProductCard" model="item" />
            </div>
        }
    </div>
}
