@model OnlineShop.Web.ViewModels.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="section-divider">
    <div class="auth-wrap">
        <div class="auth-header">
            <h1 class="auth-title">РЕГИСТРАЦИЯ<span class="accent">.</span></h1>
            <p class="auth-subtitle">★ Создайте аккаунт BREWCO</p>
        </div>

        <form asp-action="Register" method="post" class="brutal-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-brutal btn-brutal-lg w-100">Зарегистрироваться</button>
        </form>

        <p class="auth-footer">
            Уже есть аккаунт? <a asp-action="Login">Войти</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
