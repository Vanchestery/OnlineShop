@model OnlineShop.Web.ViewModels.Auth.OrderHistoryViewModel
@using OnlineShop.Web.Helpers
@using static OnlineShop.Web.Helpers.RussianPluralizer
@{
    ViewData["Title"] = "Мои заказы";
}

<section class="section-divider">
    <div class="section-head">
        <h2 class="section-title">МОИ ЗАКАЗЫ<span class="accent">.</span></h2>
        <div class="label-mono text-brutal-muted">
            ★ @Model.Orders.Count @RussianPluralizer.Orders(Model.Orders.Count)
        </div>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">∅</div>
            <p class="empty-state-text">У вас пока нет заказов</p>
            <a asp-controller="Product" asp-action="Index" class="btn-brutal">Открыть каталог</a>
        </div>
    }
    else
    {
        <table class="orders-table">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Товаров</th>
                    <th class="text-end">Сумма</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="order-id">
                            <code>@order.Id.ToString()[..8]</code>
                        </td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <span class="brutal-badge @order.Status.ToBadgeClass()">
                                @order.Status.ToRussian()
                            </span>
                        </td>
                        <td>@order.ItemsCount шт.</td>
                        <td class="text-end order-total">@order.Total.ToString("N0") ₽</td>
                        <td class="text-end">
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                               class="btn-brutal btn-brutal-sm">Открыть →</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
