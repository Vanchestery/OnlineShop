@model OnlineShop.Web.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<section class="section-divider">
    <div class="auth-wrap">
        <div class="auth-header">
            <h1 class="auth-title">ВХОД<span class="accent">.</span></h1>
            <p class="auth-subtitle">★ Войдите в свой аккаунт BREWCO</p>
        </div>

        <form asp-action="Login" method="post" class="brutal-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-checkbox">
                <input asp-for="RememberMe" id="rememberMe" />
                <label for="rememberMe">Запомнить меня</label>
            </div>

            <button type="submit" class="btn-brutal btn-brutal-lg w-100">Войти</button>
        </form>

        <p class="auth-footer">
            Нет аккаунта? <a asp-action="Register">Регистрация</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
