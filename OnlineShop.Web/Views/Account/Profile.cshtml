@model OnlineShop.Web.ViewModels.Auth.ProfileViewModel
@{
    ViewData["Title"] = "Профиль";
}

<section class="section-divider">
    <div class="section-head">
        <h2 class="section-title">ПРОФИЛЬ<span class="accent">.</span></h2>
        <div class="label-mono text-brutal-muted">★ Личный аккаунт</div>
    </div>

    <div class="brutal-card">
        <dl class="profile-list">
            <dt>Имя</dt>
            <dd>@Model.FullName</dd>

            <dt>Email</dt>
            <dd>@Model.Email</dd>

            <dt>Регистрация</dt>
            <dd>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
        </dl>

        <div class="profile-actions">
            <a asp-action="ChangePassword" class="btn-brutal btn-brutal-outline">Сменить пароль</a>
            <a asp-action="OrderHistory" class="btn-brutal">Мои заказы →</a>
        </div>
    </div>
</section>
