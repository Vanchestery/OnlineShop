@model OnlineShop.Web.ViewModels.Order.CheckoutViewModel
@{
    ViewData["Title"] = "Оформление заказа";
}

<section class="section-divider">
    <div class="section-head">
        <h2 class="section-title">ОФОРМЛЕНИЕ<span class="accent">.</span></h2>
        <div class="label-mono text-brutal-muted">★ Доставка по России</div>
    </div>

    <form asp-action="Checkout" method="post" class="checkout-grid brutal-form">

        @* ── Left: Address form ────────────────────────────────────── *@
        <div class="checkout-form-side">
            <h3 class="checkout-subtitle">Адрес доставки</h3>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Address.Country"></label>
                <input asp-for="Address.Country" autocomplete="country" />
                <span asp-validation-for="Address.Country"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Address.City"></label>
                    <input asp-for="Address.City" autocomplete="address-level2" />
                    <span asp-validation-for="Address.City"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address.ZipCode"></label>
                    <input asp-for="Address.ZipCode" autocomplete="postal-code" />
                    <span asp-validation-for="Address.ZipCode"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Address.Street"></label>
                <input asp-for="Address.Street" autocomplete="street-address" />
                <span asp-validation-for="Address.Street"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address.Apartment"></label>
                <input asp-for="Address.Apartment" />
                <span asp-validation-for="Address.Apartment"></span>
            </div>
        </div>

        @* ── Right: Cart summary ───────────────────────────────────── *@
        <div class="checkout-summary-side">
            <h3 class="checkout-subtitle">Ваш заказ</h3>

            <div class="checkout-summary-items">
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="checkout-summary-row">
                        <span class="name">
                            @item.ProductName
                            <span class="qty">× @item.Quantity</span>
                        </span>
                        <span class="sub">@item.Subtotal.ToString("N0") ₽</span>
                    </div>
                }
            </div>

            <div class="checkout-total">
                <span class="label">★ Итого:</span>
                <span class="value">@Model.Cart.Total.ToString("N0") ₽</span>
            </div>

            <button type="submit" class="btn-brutal btn-brutal-lg w-100">
                Подтвердить заказ →
            </button>
            <a asp-controller="Cart" asp-action="Index" class="auth-footer" style="margin-top: 16px;">
                ← Вернуться в корзину
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
