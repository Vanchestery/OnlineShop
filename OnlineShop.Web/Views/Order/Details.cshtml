@model OnlineShop.Web.ViewModels.Order.OrderDetailsViewModel
@using OnlineShop.Web.Helpers
@{
    ViewData["Title"] = $"Заказ {Model.Id.ToString()[..8]}";
}

<section class="section-divider">
    <div class="section-head">
        <h2 class="section-title">
            ЗАКАЗ <span style="font-family: 'Space Mono', monospace; font-size: 28px; color: var(--orange);">#@Model.Id.ToString()[..8]</span>
        </h2>
        <span class="brutal-badge @Model.Status.ToBadgeClass()">
            @Model.Status.ToRussian()
        </span>
    </div>

    <div class="order-detail-grid">
        @* ── Состав заказа ──────────────────────────────────────────── *@
        <div>
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th class="text-end">Цена</th>
                        <th class="text-center">Кол-во</th>
                        <th class="text-end">Подсумма</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a class="cart-item-name-text"
                                   asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                    @item.ProductName
                                </a>
                            </td>
                            <td class="text-end">@item.Price.ToString("N0") ₽</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-bold">@item.Subtotal.ToString("N0") ₽</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align: right; font-size: 14px; font-family: 'Space Mono', monospace; letter-spacing: 0.15em; text-transform: uppercase;">★ ИТОГО:</td>
                        <td class="text-end">@Model.Total.ToString("N0") ₽</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @* ── Информация ─────────────────────────────────────────────── *@
        <div class="order-info-card">
            <h3>Дата</h3>
            <p>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

            <h3>Адрес доставки</h3>
            <address>
                @Model.DeliveryAddress.Country, @Model.DeliveryAddress.ZipCode<br />
                @Model.DeliveryAddress.City<br />
                @Model.DeliveryAddress.Street@(string.IsNullOrEmpty(Model.DeliveryAddress.Apartment) ? "" : $", кв. {Model.DeliveryAddress.Apartment}")
            </address>
        </div>
    </div>

    <div class="order-actions">
        <a asp-controller="Account" asp-action="OrderHistory" class="btn-brutal btn-brutal-outline">
            ← К списку заказов
        </a>
        <a asp-controller="Product" asp-action="Index" class="btn-brutal">
            В каталог →
        </a>
    </div>
</section>
