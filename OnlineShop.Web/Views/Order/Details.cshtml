@model OnlineShop.Web.ViewModels.Order.OrderDetailsViewModel
@using OnlineShop.Web.Helpers
@{
    ViewData["Title"] = $"Заказ {Model.Id.ToString()[..8]}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">
        Заказ <code>@Model.Id.ToString()[..8]</code>
    </h1>
    <span class="badge fs-6 @Model.Status.ToBadgeClass()">
        @Model.Status.ToRussian()
    </span>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5 mb-3">Состав заказа</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th class="text-end">Цена</th>
                        <th class="text-center">Кол-во</th>
                        <th class="text-end">Подсумма</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId"
                                   class="text-decoration-none text-dark">
                                    @item.ProductName
                                </a>
                            </td>
                            <td class="text-end">@item.Price.ToString("N2") ₽</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-bold">@item.Subtotal.ToString("N2") ₽</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Итого:</td>
                        <td class="text-end fw-bold fs-5">@Model.Total.ToString("N2") ₽</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h5 mb-3">Информация</h2>
        <dl class="row">
            <dt class="col-sm-5">Дата</dt>
            <dd class="col-sm-7">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        <h2 class="h5 mt-4 mb-3">Адрес доставки</h2>
        <address class="mb-0">
            @Model.DeliveryAddress.Country, @Model.DeliveryAddress.ZipCode<br />
            @Model.DeliveryAddress.City<br />
            @Model.DeliveryAddress.Street@(string.IsNullOrEmpty(Model.DeliveryAddress.Apartment) ? "" : $", кв. {Model.DeliveryAddress.Apartment}")
        </address>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Account" asp-action="OrderHistory" class="btn btn-outline-secondary">
        ← К списку заказов
    </a>
    <a asp-controller="Product" asp-action="Index" class="btn btn-dark">
        В каталог
    </a>
</div>
