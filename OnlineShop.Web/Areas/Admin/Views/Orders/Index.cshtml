@model IReadOnlyList<OnlineShop.Web.Areas.Admin.ViewModels.OrderRowViewModel>
@using OnlineShop.Web.Helpers
@using OnlineShop.Db.Models
@{
    ViewData["Title"] = "Заказы";
    var currentFilter = ViewData["FilterStatus"] as OrderStatus?;
}

<h1 class="h3 mb-3">Заказы <small class="text-muted">(@Model.Count)</small></h1>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm @(currentFilter is null ? "btn-dark" : "btn-outline-secondary")">
        Все
    </a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a asp-action="Index" asp-route-status="@status"
           class="btn btn-sm @(currentFilter == status ? "btn-dark" : "btn-outline-secondary")">
            @status.ToRussian()
        </a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light text-center">Заказов нет.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Клиент</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Товаров</th>
                    <th class="text-end">Сумма</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><code>@o.Id.ToString()[..8]</code></td>
                        <td>@o.UserFullName</td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge @o.Status.ToBadgeClass()">@o.Status.ToRussian()</span></td>
                        <td>@o.ItemsCount шт.</td>
                        <td class="text-end fw-bold">@o.Total.ToString("N2") ₽</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">
                                Открыть
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
