@model IReadOnlyList<OnlineShop.Web.Areas.Admin.ViewModels.OrderRowViewModel>
@using OnlineShop.Web.Helpers
@using OnlineShop.Db.Models
@{
    ViewData["Title"] = "Заказы";
    var currentFilter = ViewData["FilterStatus"] as OrderStatus?;
}

<div class="admin-section-head">
    <h1 class="admin-section-title">
        ЗАКАЗЫ
        <span class="count">★ @Model.Count</span>
    </h1>
</div>

<div class="admin-filter-row">
    <a asp-action="Index" class="tag @(currentFilter is null ? "active" : "")">Все</a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a asp-action="Index" asp-route-status="@status"
           class="tag @(currentFilter == status ? "active" : "")">
            @status.ToRussian()
        </a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">∅</div>
        <p class="empty-state-text">Заказов не найдено</p>
    </div>
}
else
{
    <div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>№</th>
                <th>Клиент</th>
                <th>Дата</th>
                <th>Статус</th>
                <th>Товаров</th>
                <th class="text-end">Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><span class="id-code">@o.Id.ToString()[..8]</span></td>
                    <td>@o.UserFullName</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="brutal-badge @o.Status.ToBadgeClass()">@o.Status.ToRussian()</span></td>
                    <td>@o.ItemsCount шт.</td>
                    <td class="text-end fw-bold">@o.Total.ToString("N0") ₽</td>
                    <td>
                        <div class="admin-actions-cell">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn-brutal btn-brutal-sm btn-brutal-outline">Открыть</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
