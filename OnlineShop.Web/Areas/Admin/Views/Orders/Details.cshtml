@model OnlineShop.Web.Areas.Admin.ViewModels.AdminOrderDetailsViewModel
@using OnlineShop.Web.Helpers
@using OnlineShop.Db.Models
@{
    ViewData["Title"] = $"Заказ {Model.Id.ToString()[..8]}";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">
        ЗАКАЗ
        <span class="count" style="color: var(--orange); font-size: 18px;">#@Model.Id.ToString()[..8]</span>
    </h1>
    <span class="brutal-badge @Model.Status.ToBadgeClass()">@Model.Status.ToRussian()</span>
</div>

<div class="order-detail-grid">
    <div>
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Товар</th>
                    <th class="text-end">Цена</th>
                    <th class="text-center">Кол-во</th>
                    <th class="text-end">Подсумма</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end">@item.Price.ToString("N0") ₽</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end fw-bold">@item.Subtotal.ToString("N0") ₽</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" style="text-align: right; font-size: 14px; font-family: 'Space Mono', monospace; letter-spacing: 0.15em; text-transform: uppercase;">★ ИТОГО:</td>
                    <td class="text-end">@Model.Total.ToString("N0") ₽</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="order-info-card">
        <h3>Клиент</h3>
        <p>@Model.UserFullName</p>

        <h3>Дата</h3>
        <p>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

        <h3>Адрес доставки</h3>
        <address>
            @Model.DeliveryAddress.Country, @Model.DeliveryAddress.ZipCode<br />
            @Model.DeliveryAddress.City<br />
            @Model.DeliveryAddress.Street@(string.IsNullOrEmpty(Model.DeliveryAddress.Apartment) ? "" : $", кв. {Model.DeliveryAddress.Apartment}")
        </address>

        <div class="order-status-bar brutal-form">
            <h3>Сменить статус</h3>
            <form asp-action="ChangeStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-group">
                    <select name="newStatus">
                        @foreach (var status in Enum.GetValues<OrderStatus>())
                        {
                            if (status == Model.Status)
                            {
                                <option value="@status" selected>@status.ToRussian()</option>
                            }
                            else
                            {
                                <option value="@status">@status.ToRussian()</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="btn-brutal w-100">Применить</button>
            </form>
        </div>
    </div>
</div>

<div class="admin-form-actions">
    <a asp-action="Index" class="btn-brutal btn-brutal-outline">← К списку заказов</a>
</div>
