@model IReadOnlyList<OnlineShop.Web.Areas.Admin.ViewModels.UserRowViewModel>
@{
    ViewData["Title"] = "Пользователи";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">
        ПОЛЬЗОВАТЕЛИ
        <span class="count">★ @Model.Count</span>
    </h1>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Имя</th>
            <th>Роли</th>
            <th>Регистрация</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>
                    @foreach (var role in u.Roles)
                    {
                        <span class="brutal-badge brutal-badge-accent" style="margin-right: 4px;">@role</span>
                    }
                </td>
                <td>@u.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                <td>
                    <div class="admin-actions-cell">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn-brutal btn-brutal-sm btn-brutal-outline">Открыть</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
