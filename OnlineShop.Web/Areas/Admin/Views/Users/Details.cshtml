@model OnlineShop.Web.Areas.Admin.ViewModels.UserDetailsViewModel
@{
    ViewData["Title"] = Model.Email;
}

<h1 class="h3 mb-1">@Model.FullName</h1>
<p class="text-muted mb-4">@Model.Email — <small>зарегистрирован @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small></p>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Роли</h2>
                <form asp-action="ChangeRoles" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    @foreach (var role in Model.AllRoles)
                    {
                        var isChecked = Model.CurrentRoles.Contains(role);
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input"
                                   id="role_@role"
                                   name="RolesAssignment.SelectedRoles"
                                   value="@role"
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="role_@role">@role</label>
                        </div>
                    }
                    <button type="submit" class="btn btn-dark mt-3">Сохранить роли</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Сбросить пароль</h2>
                <p class="text-muted small">Старый пароль знать не нужно — это админский сброс.</p>
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="newPassword" class="form-label">Новый пароль</label>
                        <input type="password" id="newPassword"
                               name="PasswordReset.NewPassword" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Подтверждение</label>
                        <input type="password" id="confirmPassword"
                               name="PasswordReset.ConfirmPassword" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-warning">Сбросить пароль</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">← К списку пользователей</a>
</div>
