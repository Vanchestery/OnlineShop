@model OnlineShop.Web.Areas.Admin.ViewModels.UserDetailsViewModel
@{
    ViewData["Title"] = Model.Email;
}

<div class="admin-section-head">
    <div>
        <h1 class="admin-section-title">@Model.FullName</h1>
        <span class="admin-subhead-meta">★ @Model.Email · зарегистрирован @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
    </div>
</div>

<div class="admin-card-grid">
    <div class="brutal-card">
        <h3 class="admin-subhead">Роли</h3>
        <form asp-action="ChangeRoles" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="admin-roles-list">
                @foreach (var role in Model.AllRoles)
                {
                    var isChecked = Model.CurrentRoles.Contains(role);
                    <div class="form-checkbox">
                        <input type="checkbox" id="role_@role"
                               name="RolesAssignment.SelectedRoles"
                               value="@role"
                               @(isChecked ? "checked" : "") />
                        <label for="role_@role">@role</label>
                    </div>
                }
            </div>
            <button type="submit" class="btn-brutal">Сохранить роли</button>
        </form>
    </div>

    <div class="brutal-card">
        <h3 class="admin-subhead">Сбросить пароль</h3>
        <span class="admin-subhead-meta" style="margin-bottom: 16px;">★ Админский сброс — без знания старого пароля</span>

        <form asp-action="ResetPassword" method="post" class="brutal-form">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group">
                <label for="newPassword">Новый пароль</label>
                <input type="password" id="newPassword" name="PasswordReset.NewPassword" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Подтверждение</label>
                <input type="password" id="confirmPassword" name="PasswordReset.ConfirmPassword" />
            </div>

            <button type="submit" class="btn-brutal" style="background: var(--orange); border-color: var(--orange); color: white;">
                Сбросить пароль
            </button>
        </form>
    </div>
</div>

<div class="admin-form-actions">
    <a asp-action="Index" class="btn-brutal btn-brutal-outline">← К списку пользователей</a>
</div>
