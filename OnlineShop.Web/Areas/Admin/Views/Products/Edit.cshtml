@model OnlineShop.Web.Areas.Admin.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = $"Редактирование: {Model.Name}";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">РЕДАКТИРОВАНИЕ</h1>
    <span class="admin-subhead-meta">★ @Model.Name</span>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="brutal-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImagePath" />

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="admin-form-grid">
        <div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" step="0.01" />
                    <span asp-validation-for="Price"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Category"></label>
                    <select asp-for="Category"
                            asp-items="Html.GetEnumSelectList<OnlineShop.Db.Models.ProductCategory>()">
                    </select>
                    <span asp-validation-for="Category"></span>
                </div>
            </div>

            <div class="form-checkbox">
                <input asp-for="IsAvailable" />
                <label asp-for="IsAvailable">Доступен к покупке</label>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile">Сменить фото</label>
                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="ImageFile"></span>
                <small class="admin-subhead-meta" style="margin-top: 6px;">★ Оставьте пустым чтобы сохранить текущее</small>
            </div>
        </div>

        <div>
            <h4 class="admin-subhead">Текущее фото</h4>
            <div class="admin-image-preview">
                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                {
                    <img src="@Model.ExistingImagePath" alt="@Model.Name" />
                }
                else
                {
                    <span class="admin-image-preview-empty">★ Нет фото</span>
                }
            </div>
        </div>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="btn-brutal">Сохранить</button>
        <a asp-action="Index" class="btn-brutal btn-brutal-outline">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
