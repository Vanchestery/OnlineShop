@model IReadOnlyList<OnlineShop.Web.Areas.Admin.ViewModels.ProductRowViewModel>
@using OnlineShop.Web.Helpers
@{
    ViewData["Title"] = "Товары";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">
        ТОВАРЫ
        <span class="count">★ @Model.Count</span>
    </h1>
    <a asp-action="Create" class="btn-brutal">+ Новый товар</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th style="width: 64px"></th>
            <th>Название</th>
            <th>Категория</th>
            <th class="text-end">Цена</th>
            <th class="text-center">Статус</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(p.ImagePath))
                    {
                        <img src="@p.ImagePath" alt="@p.Name" class="admin-thumb" />
                    }
                    else
                    {
                        <div class="admin-thumb-placeholder">@(p.Name.Length > 0 ? p.Name.Substring(0, 1).ToUpper() : "?")</div>
                    }
                </td>
                <td>@p.Name</td>
                <td><span class="brutal-badge">@p.Category.ToRussian()</span></td>
                <td class="text-end">@p.Price.ToString("N0") ₽</td>
                <td class="text-center">
                    @if (p.IsAvailable)
                    {
                        <span class="brutal-badge brutal-badge-lime">доступен</span>
                    }
                    else
                    {
                        <span class="brutal-badge brutal-badge-gray">скрыт</span>
                    }
                </td>
                <td>
                    <div class="admin-actions-cell">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn-brutal btn-brutal-sm btn-brutal-outline">Edit</a>
                        <form asp-action="Delete" method="post" class="m-0"
                              onsubmit="return confirm('Удалить «@p.Name»?');">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn-brutal btn-brutal-sm" style="background: var(--orange); color: white; border-color: var(--orange);">×</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
