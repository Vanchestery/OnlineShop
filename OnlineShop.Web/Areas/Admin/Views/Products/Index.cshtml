@model IReadOnlyList<OnlineShop.Web.Areas.Admin.ViewModels.ProductRowViewModel>
@{
    ViewData["Title"] = "Товары";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Товары <small class="text-muted">(@Model.Count)</small></h1>
    <a asp-action="Create" class="btn btn-dark">+ Добавить товар</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th style="width: 80px"></th>
                <th>Название</th>
                <th class="text-end">Цена</th>
                <th class="text-center">Статус</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@p.Name"
                                 style="height: 50px; width: 50px; object-fit: cover; border-radius: .25rem" />
                        }
                        else
                        {
                            <div class="text-muted" style="height: 50px; width: 50px;
                                background: #f5f5f5; display: flex; align-items: center;
                                justify-content: center; border-radius: .25rem">—</div>
                        }
                    </td>
                    <td>@p.Name</td>
                    <td class="text-end">@p.Price.ToString("N2") ₽</td>
                    <td class="text-center">
                        @if (p.IsAvailable)
                        {
                            <span class="badge bg-success">доступен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">скрыт</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                            Редактировать
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Удалить товар «@p.Name»?');">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
