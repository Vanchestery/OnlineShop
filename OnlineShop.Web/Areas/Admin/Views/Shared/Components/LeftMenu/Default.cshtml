@model string

@{
    string ActiveIf(string controller) => Model == controller ? "is-active" : string.Empty;
}

<ul class="admin-menu">
    <li>
        <a class="admin-menu-item @ActiveIf("Products")"
           asp-area="Admin" asp-controller="Products" asp-action="Index">
            ★ Товары
        </a>
    </li>
    <li>
        <a class="admin-menu-item @ActiveIf("Orders")"
           asp-area="Admin" asp-controller="Orders" asp-action="Index">
            ★ Заказы
        </a>
    </li>
    <li>
        <a class="admin-menu-item @ActiveIf("Users")"
           asp-area="Admin" asp-controller="Users" asp-action="Index">
            ★ Пользователи
        </a>
    </li>
    <li>
        <a class="admin-menu-item @ActiveIf("Roles")"
           asp-area="Admin" asp-controller="Roles" asp-action="Index">
            ★ Роли
        </a>
    </li>
</ul>
