<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BREWCO ADMIN</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/brutal.css" asp-append-version="true" />
</head>
<body>
    <header class="admin-header">
        <a class="admin-logo" asp-area="" asp-controller="Home" asp-action="Index">
            BREWCO <span class="admin-logo-badge">ADMIN</span>
        </a>
        <a class="admin-header-back" asp-area="" asp-controller="Home" asp-action="Index">
            ← Вернуться в магазин
        </a>
    </header>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            @await Component.InvokeAsync("LeftMenu")
        </aside>

        <main class="admin-main">
            @if (TempData["StatusMessage"] is string status)
            {
                <div class="brutal-alert" style="margin-bottom: 24px;">
                    <span>★ @status</span>
                    <button type="button" class="brutal-alert-close" onclick="this.parentElement.remove()">×</button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
