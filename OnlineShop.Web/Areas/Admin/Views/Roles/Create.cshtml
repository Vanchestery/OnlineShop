@model OnlineShop.Web.Areas.Admin.ViewModels.CreateRoleViewModel
@{
    ViewData["Title"] = "Новая роль";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">НОВАЯ РОЛЬ</h1>
</div>

<div class="brutal-card" style="max-width: 540px;">
    <form asp-action="Create" method="post" class="brutal-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" autofocus />
            <span asp-validation-for="Name"></span>
            <small class="admin-subhead-meta" style="margin-top: 6px;">
                ★ Только латиница, цифры, подчёркивание · начало — с буквы
            </small>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-brutal">Создать</button>
            <a asp-action="Index" class="btn-brutal btn-brutal-outline">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
