@model IReadOnlyList<string>
@{
    ViewData["Title"] = "Роли";
}

<div class="admin-section-head">
    <h1 class="admin-section-title">
        РОЛИ
        <span class="count">★ @Model.Count</span>
    </h1>
    <a asp-action="Create" class="btn-brutal">+ Новая роль</a>
</div>

<div class="admin-table-wrap">
<table class="admin-table">
    <thead>
        <tr>
            <th>Имя</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td><span class="brutal-badge brutal-badge-accent">@role</span></td>
            </tr>
        }
    </tbody>
</table>
</div>
